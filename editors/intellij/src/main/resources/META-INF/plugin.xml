<idea-plugin>
  <id>dev.stylebreeze.intellij</id>
  <name>StyleBreeze</name>
  <vendor>Ivan Kobtsev</vendor>
  <description>Reliable CSS Modules navigation powered by the StyleBreeze language server.</description>
  <depends>com.intellij.modules.ultimate</depends>
  <depends>com.intellij.modules.lsp</depends>
  <depends>JavaScript</depends>
  <extensions defaultExtensionNs="com.intellij">
    <platform.lsp.integrationProvider implementation="dev.stylebreeze.intellij.StyleBreezeLspProvider"/>
    <gotoDeclarationHandler
        implementation="dev.stylebreeze.intellij.StyleBreezeGotoDeclarationHandler"
        order="first"/>
    <completion.contributor
        language="any"
        implementationClass="dev.stylebreeze.intellij.StyleBreezeCompletionContributor"
        order="first"/>
  </extensions>
</idea-plugin>
