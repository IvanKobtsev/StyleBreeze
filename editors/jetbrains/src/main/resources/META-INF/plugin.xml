<idea-plugin>
  <id>dev.stylebreeze.jetbrains</id>
  <name>StyleBreeze</name>
  <vendor url="https://github.com/IvanKobtsev/StyleBreeze">Ivan Kobtsev</vendor>
  <description><![CDATA[StyleContract-compatible CSS and SCSS module diagnostics and precise navigation powered by a native Rust language server.]]></description>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.ultimate</depends>
  <depends>com.intellij.modules.lsp</depends>
  <depends>JavaScript</depends>
  <extensions defaultExtensionNs="com.intellij">
    <platform.lsp.integrationProvider implementation="dev.stylebreeze.jetbrains.StyleBreezeLspIntegrationProvider"/>
    <gotoDeclarationHandler implementation="dev.stylebreeze.jetbrains.StyleBreezeGotoDeclarationHandler" order="first"/>
    <postStartupActivity implementation="dev.stylebreeze.jetbrains.StyleBreezeProjectActivity"/>
    <projectConfigurable id="dev.stylebreeze.jetbrains.settings" displayName="StyleBreeze" instance="dev.stylebreeze.jetbrains.StyleBreezeConfigurable"/>
    <notificationGroup id="StyleBreeze" displayType="BALLOON"/>
  </extensions>
</idea-plugin>
